# A single installed LLVM must supply both llvmbpf and Luthier. Matching only
# the major version is insufficient for Luthier's private AMDGPU APIs.
cmake_minimum_required(VERSION 3.24)
if(NOT BPFTIME_LLVM_JIT)
  message(FATAL_ERROR "ROCm attach requires BPFTIME_LLVM_JIT=ON")
endif()
if(ENABLE_LLVM_SHARED)
  message(FATAL_ERROR "ROCm attach requires ENABLE_LLVM_SHARED=OFF: Luthier links static LLVM components")
endif()
if(NOT BPFTIME_ROCM_ROOT)
  message(FATAL_ERROR "ROCm attach requires BPFTIME_ROCM_ROOT pointing to the ROCm package installation")
endif()

foreach(_package IN ITEMS LLVM Clang)
  string(TOLOWER "${_package}" _directory)
  set(_expected "${BPFTIME_ROCM_ROOT}/lib/llvm/lib/cmake/${_directory}")
  if(NOT EXISTS "${_expected}/${_package}Config.cmake")
    message(FATAL_ERROR "Missing ${_expected}/${_package}Config.cmake; install the ROCm LLVM development packages")
  endif()
  file(REAL_PATH "${_expected}" _expected_real)
  # Respect explicit settings, including the environment, but reject a
  # different installation rather than silently overriding an existing cache.
  set(_requested "${${_package}_DIR}")
  if(NOT _requested AND DEFINED ENV{${_package}_DIR})
    set(_requested "$ENV{${_package}_DIR}")
  endif()
  if(_requested)
    file(REAL_PATH "${_requested}" _requested_real)
    if(NOT _requested_real STREQUAL _expected_real)
      message(FATAL_ERROR "ROCm attach requires ${_package}_DIR=${_expected}; got ${_requested}. Use a fresh build directory or select the same ROCm LLVM installation for llvmbpf and Luthier")
    endif()
  endif()
  set(${_package}_DIR "${_expected}" CACHE PATH "Unified ROCm ${_package} package" FORCE)
endforeach()

find_package(LLVM REQUIRED CONFIG NO_DEFAULT_PATH PATHS "${LLVM_DIR}")
if(NOT LLVM_VERSION_MAJOR EQUAL 24)
  message(FATAL_ERROR "The pinned Luthier fork requires ROCm LLVM 24; found ${LLVM_PACKAGE_VERSION}")
endif()
message(STATUS "Unified llvmbpf/Luthier LLVM: ${LLVM_DIR} (${LLVM_PACKAGE_VERSION}, RTTI=${LLVM_ENABLE_RTTI})")
