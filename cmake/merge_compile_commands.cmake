# Merge an ExternalProject compilation database into its parent's database.
# Replace previous entries for external sources so repeated builds do not
# duplicate commands or retain stale toolchain/include paths.
cmake_minimum_required(VERSION 3.19)
file(READ "${PRIMARY}" _primary)
file(READ "${SECONDARY}" _secondary)
string(JSON _secondary_count LENGTH "${_secondary}")
set(_external_files)
if(_secondary_count GREATER 0)
  math(EXPR _last "${_secondary_count} - 1")
  foreach(_index RANGE ${_last})
    string(JSON _file GET "${_secondary}" ${_index} file)
    list(APPEND _external_files "${_file}")
  endforeach()
endif()

set(_merged "[")
set(_separator "")
foreach(_database IN ITEMS _primary _secondary)
  string(JSON _count LENGTH "${${_database}}")
  if(_count EQUAL 0)
    continue()
  endif()
  math(EXPR _last "${_count} - 1")
  foreach(_index RANGE ${_last})
    string(JSON _entry GET "${${_database}}" ${_index})
    string(JSON _file GET "${_entry}" file)
    if(_database STREQUAL "_primary" AND _file IN_LIST _external_files)
      continue()
    endif()
    string(APPEND _merged "${_separator}\n${_entry}")
    set(_separator ",")
  endforeach()
endforeach()
string(APPEND _merged "\n]\n")

# clangd can reload the database while a build is running.
file(WRITE "${PRIMARY}.tmp" "${_merged}")
file(RENAME "${PRIMARY}.tmp" "${PRIMARY}")
